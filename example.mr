import("common.mr")

func some_fn(val) {
  write("abs(a) = ", if val < 0 { -val } else { val }, "\n")
}

func add(a, b) {
  if a > 0 {
    return a + b
  }
  some_fn(a)
  return a + b
}

write(add(-33, -36), "\n")

i = 0
while (i = i + 1) < 10 {
  if i == 3 and !nil { continue }
  if i == 7 { break }
  write(i, "\n")
}
write("final i = ", i, "\n")

lst=[1, 2, 3]
write(lst, "\n")
lst[0] = 69
write(lst, "\n")
lst = append(lst, ["HELLO", 420])
write(lst, "\n")
write(lst[len(lst)-1][1], "\n")

n = to_int(read("what is your age? "))
write("your age + 69 is ", n + 69, "\n")

