
func other_fn(val) {
  print("abs(a) = ", if val < 0 { -val } else { val }, "\n")
}

func add(a, b) {
  if a > 0 {
    return a + b
  }
  other_fn(a)
  return a + b
}

print(add(-33, -36), "\n")

i = 0
while (i = i + 1) < 10 {
  if i == 3 and !nil { continue }
  if i == 7 { break }
  print(i, "\n")
}
print("final i = ", i, "\n")

lst=[1, 2, 3]
print(lst, "\n")
lst[0] = 69
print(lst, "\n")
lst = append(lst, ["HELLO", 420])
print(lst, "\n")
print(lst[len(lst)-1][1], "\n")

n = to_int(read("what is your age? "))
print("your age + 69 is ", n + 69, "\n")

